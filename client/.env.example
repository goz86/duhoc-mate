VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SOCKET_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Optional: TURN relay for reliable WebRTC voice across different networks.
# Keep all three empty to use Google STUN only.
VITE_TURN_URL=turn:your-turn-host.example.com:3478
# Optional alternative: comma-separated list from Metered "Show ICE Servers Array".
VITE_TURN_URLS=turn:your-turn-host.example.com:80,turns:your-turn-host.example.com:443?transport=tcp
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password
